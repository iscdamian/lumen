# Lumen auto-share configuration (sourced by the supervisor).
#
# Edit, then: ./restart.sh   (or re-run ./install.sh)

# OS network interface to bind to (the server binds to this interface's
# current IPv4 address only — never all interfaces). DHCP changes are
# handled automatically; 192.168.188.127 is preferred when still assigned.
LUMEN_INTERFACE="en1"

# HTTP / WebRTC signaling port.
LUMEN_PORT="3131"

# Hard process lifetime in seconds. Every interval the whole Lumen process
# is terminated and replaced. 1800 = 30 minutes.
LUMEN_RESTART_INTERVAL="1800"

# Seconds to wait for a graceful shutdown before SIGKILL.
LUMEN_SHUTDOWN_GRACE="10"

# Extra raw `lumen serve` arguments appended verbatim, e.g.:
#   LUMEN_EXTRA_ARGS="--quality high --no-audio"
# The supervisor always passes: --auth-mode none --no-qr --allow-lan-admin
LUMEN_EXTRA_ARGS=""
